#!/usr/bin/env bash
set -euo pipefail

ADJECTIVES=(amber brisk calm crisp dusty eager fuzzy gentle golden hollow icy jolly keen lively mellow misty nimble oaken quiet rapid rosy rustic silver sleek stormy sunny swift tidal velvet witty)
NOUNS=(anchor badger brook canyon cedar comet delta ember falcon fern glacier harbor heron island juniper lagoon lantern maple meadow otter pebble quartz raven reef ridge sparrow thicket tundra valley willow)

die() {
  printf 'wtree: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
usage: wtree       search the worktrees of this repo
                enter: open, ctrl-d: delete, ctrl-f: force delete, ctrl-r: reload
       wtree -n    create a worktree at the current HEAD in ../worktrees and open it
       wtree -d    search the Docker Compose stacks of this repo and its worktrees, with usage
                enter: open, ctrl-s: stop, ctrl-d: delete and keep volumes,
                ctrl-f: delete with volumes, ctrl-r: reload
       wtree -g    search all the worktrees on this machine, in any directory
       wtree -g -d search all the Docker Compose stacks on this machine, in any directory

In a list, tab selects an entry and ctrl-a selects all the matches. A key then acts on all the
selected entries, after one confirmation, and shows the progress.
On screens narrower than 60 columns, enter or a tap opens a menu of these actions.
Opening a worktree that is already open jumps to its tab.
A deleted worktree offers to delete its stacks, and a deleted stack offers to delete its worktree.
The ../worktrees directory is beside the main checkout. Needs git and fzf, and docker for -d.
wtree -g looks for repos in $HOME, or in the directories of WTREE_ROOTS, separated by a colon.
Opens or jumps to a tab in Rex, herdr, cmux, tmux, zellij, WezTerm, kitty, Ghostty, iTerm2, and Terminal.
Other terminals get the path.
EOF
}

main_worktree() {
  main_of .
}

# git -C accepts a checkout or a .git directory, and a worktree that is gone still has its repo
main_of() {
  { git -C "$1" worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p'; } || true
}

common_of() {
  git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null
}

is_global() {
  [[ -n ${WTREE_GLOBAL:-} ]]
}

plural() {
  if (($1 == 1)); then printf '1 %s' "$2"; else printf '%d %ss' "$1" "$2"; fi
}

short_path() {
  case $1 in
    "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;;
    *) printf '%s' "$1" ;;
  esac
}

term_cols() {
  local size
  size=$({ stty size </dev/tty; } 2>/dev/null) || size=
  printf '%s' "${size##* }"
  if [[ -z $size ]]; then printf '%s' "${COLUMNS:-80}"; fi
}

is_narrow() {
  (($(term_cols) < 60))
}

require_fzf() {
  command -v fzf >/dev/null 2>&1 || die "fzf is not on PATH"
  local version major minor
  version=$(fzf --version)
  version=${version%% *}
  major=${version%%.*}
  minor=${version#*.}
  minor=${minor%%.*}
  if ((major == 0 && minor < 53)); then die "wtree needs fzf 0.53 or later, this is fzf $version"; fi
}

# fzf exits 1 when enter finds no match, such as while the list still loads
fzf_exit() {
  case $1 in
    1) return 0 ;;
    130) exit 0 ;;
    *) die "fzf failed with exit code $1" ;;
  esac
}

menu() {
  local title=$1
  shift
  printf '%s\n' "$@" | fzf --layout=reverse --height=100% --no-info --no-separator --no-scrollbar \
    --prompt="$title > " --bind='left-click:accept'
}

# a wedged Docker Desktop hangs every docker call, and the worktree list must still open
limited() {
  "$@" &
  local job=$! watchdog status=0
  (
    sleep 3
    kill "$job"
  ) >/dev/null 2>&1 &
  watchdog=$!
  { wait "$job"; } 2>/dev/null || status=$?
  { kill "$watchdog" && wait "$watchdog"; } 2>/dev/null || true
  return "$status"
}

worktree_of() {
  local dir=$1 anchor=$2 best='' path
  [[ -n $dir ]] || return 0
  while read -r path; do
    if [[ ($dir == "$path" || $dir == "$path"/*) && ${#path} -gt ${#best} ]]; then best=$path; fi
  done < <(git -C "$anchor" worktree list --porcelain 2>/dev/null | sed -n 's/^worktree //p')
  printf '%s' "$best"
}

stack_pairs() {
  { limited docker ps -a --filter label=com.docker.compose.project --format '{{.Label "com.docker.compose.project"}}|{{.Label "com.docker.compose.project.working_dir"}}' 2>/dev/null | sort -u; } || true
}

stacks_in_worktree() {
  local path=$1 common=$2 pairs=$3 project dir
  printf '%s\n' "$pairs" | while IFS='|' read -r project dir; do
    if [[ $dir == "$path" || $dir == "$path"/* ]] && [[ $(worktree_of "$dir" "$common") == "$path" ]]; then
      printf '%s\n' "$project"
    fi
  done | sort -u
}

# git keeps no list of the repos on a machine, so look for .git entries
scan_repos() {
  local root dotgit roots
  roots=${WTREE_ROOTS:-$HOME}
  printf '%s\n' "$roots" | tr ':' '\n' | while read -r root; do
    [[ -n $root ]] || continue
    find "$root" -xdev \( -type d \( -name node_modules -o -name .cache -o -name .local -o -name .config -o -name .tmp -o -path "*/.claude/plugins" -o -name .npm -o -name .cargo -o -name .rustup -o -name .nvm \
      -o -name .venv -o -name venv -o -name __pycache__ -o -name .pnpm-store -o -name .Trash -o -path "$root/Library" \) -prune \) \
      -o -name .git -print -prune 2>/dev/null || true
  done | while read -r dotgit; do
    if [[ ! -d $dotgit ]]; then
      repo_of_dir "${dotgit%/.git}"
    elif [[ -f $dotgit/HEAD ]]; then
      (cd "$dotgit" && pwd -P)
    fi
  done | sort -u
}

# a submodule has its own .git entry, but it is not a worktree
repo_of_dir() {
  if [[ -z $(git -C "$1" rev-parse --show-superproject-working-tree 2>/dev/null) ]]; then common_of "$1" || true; fi
}

rescan_repos() {
  local dir tmp
  dir=$(cache_dir)
  mkdir -p "$dir"
  tmp="$dir/repos.$$"
  scan_repos >"$tmp"
  mv "$tmp" "$dir/repos"
}

# the scan can take long on a large disk, so a list reads the last result and a new scan runs behind it
known_repos() {
  local file
  file="$(cache_dir)/repos"
  if [[ ! -f $file ]]; then
    rescan_repos
  elif [[ -n $(find "$file" -mmin +30) ]]; then
    (rescan_repos) </dev/null >/dev/null 2>&1 &
  fi
  cat "$file"
}

# a stack can be outside the directories that the scan reads
list_repos() {
  local stack_dirs=$1 dir common
  if ! is_global; then
    common_of "$PWD"
    return 0
  fi
  {
    known_repos
    printf '%s\n' "$stack_dirs" | sort -u | while read -r dir; do
      if [[ -n $dir && -d $dir ]]; then repo_of_dir "$dir"; fi
    done
    repo_of_dir "$PWD"
  } | sort -u | while read -r common; do
    if [[ -d $common ]]; then printf '%s\n' "$common"; fi
  done
}

worktree_stream() {
  local common
  while read -r common; do
    printf 'repo %s\n' "$common"
    git -C "$common" worktree list --porcelain 2>/dev/null || true
  done
}

list_worktrees() {
  local stacks
  stacks=$(limited docker ps -a --filter label=com.docker.compose.project --format 'STACK\t{{.Label "com.docker.compose.project"}}\t{{.Label "com.docker.compose.project.working_dir"}}\t{{.State}}' 2>/dev/null) || stacks=
  {
    if [[ -n $stacks ]]; then printf '%s\n' "$stacks"; fi
    list_repos "$(printf '%s\n' "$stacks" | cut -s -f3)" | worktree_stream
  } | awk -v home="$HOME" -v cols="$(term_cols)" -v global="${WTREE_GLOBAL:-}" '
    function basename_of(p) { sub(/\/$/, "", p); sub(/.*\//, "", p); return p }
    /^STACK\t/ { split($0, f, "\t"); s++; sp[s] = f[2]; sd[s] = f[3]; ss[s] = f[4]; next }
    /^repo /     { repo = substr($0, 6); first = 1; next }
    /^worktree / { path = substr($0, 10); ref = ""; gone = ""; bare = 0 }
    /^branch /   { ref = substr($0, 8); sub(/^refs\/heads\//, "", ref) }
    /^detached/  { ref = "(detached)" }
    /^prunable/  { gone = " [missing]" }
    /^bare/      { bare = 1 }
    /^$/ {
      if (first) { reponame = basename_of(path); sub(/\.git$/, "", reponame) }
      main = first; first = 0
      if (bare && global != "") next
      w++; wp[w] = path; wr[w] = ref; wg[w] = gone; wc[w] = repo; wn[w] = reponame; wm[w] = main
    }
    END {
      for (i = 1; i <= s; i++) {
        best = 0; bestlen = 0
        for (j = 1; j <= w; j++) {
          if ((sd[i] == wp[j] || index(sd[i], wp[j] "/") == 1) && length(wp[j]) > bestlen) { best = j; bestlen = length(wp[j]) }
        }
        if (!best) continue
        if (!((best, sp[i]) in total)) { names[best] = names[best] " " sp[i] }
        total[best, sp[i]]++
        if (ss[i] == "running") up[best, sp[i]]++
      }
      for (j = 1; j <= w; j++) {
        path = wp[j]
        name = path; sub(/.*\//, "", name)
        shown = path
        if (index(shown, home "/") == 1) shown = "~" substr(shown, length(home) + 1)
        docker = ""
        count = split(names[j], list, " ")
        for (i = 1; i <= count; i++) docker = docker (i > 1 ? ", " : "") sprintf("%s %d/%d up", list[i], up[j, list[i]], total[j, list[i]])
        owner = (global != "" && !wm[j]) ? "  \033[34m" wn[j] "\033[0m" : ""
        if (cols < 60) {
          if (length(shown) > cols - 6) shown = "…" substr(shown, length(shown) - cols + 8)
          printf "%s\t%s\t\033[1m%s\033[0m%s\037  \033[36m%s\033[0m\037  \033[2m%s%s\033[0m", path, wc[j], name, owner, wr[j], shown, wg[j]
          if (docker != "") printf "\037  \033[33mdocker: %s\033[0m", docker
          printf "\n"
        } else {
          printf "%s\t%s\t\033[1m%s\033[0m%s", path, wc[j], name, owner
          if (docker != "") printf "  \033[33mdocker: %s\033[0m", docker
          printf "\037  \033[36m%s\033[0m  \033[2m%s%s\033[0m\n", wr[j], shown, wg[j]
        }
      }
    }' | tr '\n\037' '\0\n'
}

terminal_kind() {
  local program=${TERM_PROGRAM:-}
  if [[ $program == herdr ]]; then
    printf 'herdr'
  elif [[ -n ${ZELLIJ:-} ]]; then
    printf 'zellij'
  elif [[ $program == tmux || (-n ${TMUX:-} && $program != rex) ]]; then
    printf 'tmux'
  elif [[ $program == rex ]]; then
    printf 'rex'
  elif [[ -n ${CMUX_WORKSPACE_ID:-} ]]; then
    printf 'cmux'
  elif [[ -n ${WEZTERM_PANE:-} ]]; then
    printf 'wezterm'
  elif [[ -n ${KITTY_WINDOW_ID:-} ]]; then
    printf 'kitty'
  else
    case $program in
      ghostty) printf 'ghostty' ;;
      iTerm.app) printf 'iterm' ;;
      Apple_Terminal) printf 'terminal' ;;
      *) if [[ -n ${REX_SESSION:-} ]]; then printf 'rex'; else printf 'unknown'; fi ;;
    esac
  fi
}

in_target() {
  local cwd=$1 target=$2 owner
  [[ $cwd == "$target" || $cwd == "$target"/* ]] || return 1
  owner=$(worktree_of "$cwd" "$target")
  [[ -z $owner || $owner == "$target" ]]
}

tty_cwd() {
  local pid
  pid=$(ps -t "${1#/dev/}" -o pid=,stat= | awk '$2 ~ /\+/ { pid = $1 } END { print pid }')
  [[ -n $pid ]] || return 1
  lsof -a -d cwd -p "$pid" -Fn 2>/dev/null | sed -n 's/^n//p' | head -n 1
}

rex_cmd() {
  "${REX_BIN_DIR:+$REX_BIN_DIR/}rex" "$@"
}

# the app keeps its own visible tab, so focusing the block on the server does not move the screen
rex_show_window() {
  local session=$1 window=$2 clients client shown=''
  clients=$(rex_cmd api call client.list "{\"kinds\":[\"app\"],\"session_id\":\"$REX_SESSION\"}" | grep -oE '"client_id": *"[^"]*"' | cut -d'"' -f4) || clients=
  if [[ -z $clients ]]; then
    clients=$(rex_cmd api call client.list '{"kinds":["app"]}' | grep -oE '"client_id": *"[^"]*"' | cut -d'"' -f4) || clients=
  fi
  for client in $clients; do
    if rex_cmd api call client.perform "{\"client_id\":\"$client\",\"action\":\"session.select\",\"args\":{\"session_id\":\"$session\",\"window_id\":\"$window\"},\"origin\":\"cli\"}" >/dev/null 2>&1; then shown=1; fi
  done
  if [[ -z $shown ]]; then
    printf 'wtree: this worktree is open in another tab, turn on Remote Control in Rex to jump there\n' >&2
  fi
}

rex_focus_existing() {
  local target=$1 session block window cwd sessions
  sessions=$(rex_cmd api call session.list | grep -oE '"session_id": *"[^"]*"' | cut -d'"' -f4 | grep -Fxv "$REX_SESSION") || sessions=
  for session in "$REX_SESSION" $sessions; do
    while read -r block window; do
      [[ $block != "${REX_BLOCK:-}" ]] || continue
      cwd=$(rex_cmd api call -s "$session" com.superlogical.terminal.process "{\"block_id\":\"$block\"}" 2>/dev/null |
        sed -n 's/.*"foreground": *{\([^}]*\)}.*/\1/p' | grep -oE '"cwd": *"[^"]*"' | cut -d'"' -f4) || continue
      in_target "$cwd" "$target" || continue
      rex_cmd block focus -s "$session" "$block" >/dev/null
      rex_show_window "$session" "$window"
      return 0
    done < <(rex_cmd block ls -s "$session" --json --short=false | grep -oE '"(block_id|window_id)": *"[^"]*"' |
      awk -F'"' '$2 == "block_id" { block = $4 } $2 == "window_id" { print block, $4 }')
  done
  return 1
}

rex_new_tab() {
  rex_cmd window new --cwd "$1" "$(basename "$1")" >/dev/null
}

tmux_focus_existing() {
  local target=$1 cwd pane window
  while IFS=$'\t' read -r cwd pane window; do
    [[ $pane != "${TMUX_PANE:-}" ]] || continue
    in_target "$cwd" "$target" || continue
    tmux switch-client -t "$window" 2>/dev/null || true
    tmux select-window -t "$window"
    tmux select-pane -t "$pane"
    return 0
  done < <(tmux list-panes -a -F "#{pane_current_path}"$'\t'"#{pane_id}"$'\t'"#{session_name}:#{window_id}")
  return 1
}

tmux_new_tab() {
  tmux new-window -c "$1" -n "$(basename "$1")"
}

herdr_focus_existing() {
  local target=$1 pane tab cwd
  while IFS=$'\t' read -r pane tab cwd; do
    [[ $pane != "${HERDR_PANE_ID:-}" ]] || continue
    in_target "$cwd" "$target" || continue
    herdr workspace focus "${tab%%:*}" >/dev/null
    herdr tab focus "$tab" >/dev/null
    return 0
  done < <(herdr pane list | grep -oE '"(foreground_cwd|pane_id|tab_id)":"[^"]*"' |
    awk -F'"' '$2 == "foreground_cwd" { cwd = $4 } $2 == "pane_id" { pane = $4 } $2 == "tab_id" { print pane "\t" $4 "\t" cwd }')
  return 1
}

herdr_new_tab() {
  herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$1" --label "$(basename "$1")" --focus >/dev/null
}

zellij_focus_existing() {
  local target=$1 pane cwd
  while IFS=$'\t' read -r pane cwd; do
    [[ $pane != "${ZELLIJ_PANE_ID:-}" ]] || continue
    in_target "$cwd" "$target" || continue
    zellij action focus-pane-id "terminal_$pane" >/dev/null
    return 0
  done < <(zellij action list-panes --json | tr -d '\n' | sed 's/},  *{/}\n{/g' | awk '
    /"is_plugin": *false/ {
      id = $0; sub(/.*"id": */, "", id); sub(/[^0-9].*/, "", id)
      cwd = $0; if (!sub(/.*"pane_cwd": *"/, "", cwd)) next
      sub(/".*/, "", cwd)
      print id "\t" cwd
    }')
  return 1
}

zellij_new_tab() {
  zellij action new-tab --cwd "$1" --name "$(basename "$1")" >/dev/null
}

cmux_cmd() {
  "${CMUX_BUNDLED_CLI_PATH:-cmux}" "$@"
}

cmux_focus_existing() {
  local target=$1 workspace cwd
  while read -r workspace; do
    [[ $workspace != "${CMUX_WORKSPACE_ID:-}" ]] || continue
    while read -r cwd; do
      in_target "$cwd" "$target" || continue
      cmux_cmd select-workspace --workspace "$workspace" >/dev/null
      return 0
    done < <(cmux_cmd sidebar-state --workspace "$workspace" | sed -nE 's/^[[:space:]]*"?cwd"?[=:][[:space:]]*"?([^"]*)"?,?[[:space:]]*$/\1/p')
  done < <(cmux_cmd list-workspaces | grep -oE 'workspace:[0-9]+')
  return 1
}

cmux_new_tab() {
  cmux_cmd new-workspace --cwd "$1" --name "$(basename "$1")" >/dev/null
}

wezterm_cmd() {
  "${WEZTERM_EXECUTABLE_DIR:+$WEZTERM_EXECUTABLE_DIR/}wezterm" "$@"
}

wezterm_focus_existing() {
  local target=$1 pane cwd
  while IFS=$'\t' read -r pane cwd; do
    [[ $pane != "${WEZTERM_PANE:-}" ]] || continue
    in_target "$cwd" "$target" || continue
    wezterm_cmd cli activate-pane --pane-id "$pane"
    return 0
  done < <(wezterm_cmd cli list --format json | awk '
    /"pane_id":/ { pane = $0; gsub(/[^0-9]/, "", pane) }
    /"cwd":/ {
      cwd = $0; sub(/.*"cwd": *"file:\/\/[^\/]*/, "", cwd); sub(/".*/, "", cwd); gsub(/%20/, " ", cwd)
      print pane "\t" cwd
    }')
  return 1
}

wezterm_new_tab() {
  wezterm_cmd cli spawn --cwd "$1" >/dev/null
}

kitty_focus_existing() {
  local escaped
  escaped=$(printf '%s' "$1" | sed 's/[][\.*^$+?(){}|]/\\&/g')
  kitten @ focus-window --match "cwd:\"^$escaped\$\" or cwd:\"^$escaped/\"" >/dev/null
}

kitty_new_tab() {
  if ! kitten @ launch --type=tab --cwd="$1" --tab-title="$(basename "$1")" >/dev/null; then
    printf 'wtree: set allow_remote_control in kitty.conf to open tabs\n' >&2
    return 1
  fi
}

ghostty_focus_existing() {
  [[ $(osascript - "$1" 2>/dev/null <<'EOF'
on run argv
  set target to item 1 of argv
  tell application "Ghostty"
    repeat with t in terminals
      set d to working directory of t
      if d is target or d starts with (target & "/") then
        focus t
        return "found"
      end if
    end repeat
  end tell
  return ""
end run
EOF
) == found ]]
}

ghostty_new_tab() {
  osascript - "$1" >/dev/null <<'EOF'
on run argv
  tell application "Ghostty"
    set cfg to new surface configuration
    set initial working directory of cfg to item 1 of argv
    new tab in front window with configuration cfg
  end tell
end run
EOF
}

iterm_focus_existing() {
  local target=$1 id tty cwd
  while IFS=$'\t' read -r id tty; do
    cwd=$(tty_cwd "$tty") || continue
    in_target "$cwd" "$target" || continue
    osascript - "$id" >/dev/null <<'EOF'
on run argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        repeat with s in sessions of t
          if id of s is item 1 of argv then
            select w
            select t
            select s
            activate
            return
          end if
        end repeat
      end repeat
    end repeat
  end tell
end run
EOF
    return 0
  done < <(osascript <<'EOF'
set out to ""
set sep to tab
tell application "iTerm2"
  repeat with w in windows
    repeat with t in tabs of w
      repeat with s in sessions of t
        set out to out & (id of s) & sep & (tty of s) & linefeed
      end repeat
    end repeat
  end repeat
end tell
return out
EOF
  )
  return 1
}

iterm_new_tab() {
  osascript - "$1" >/dev/null <<'EOF'
on run argv
  tell application "iTerm2"
    tell current window
      set newTab to (create tab with default profile)
      tell current session of newTab to write text "cd " & quoted form of (item 1 of argv)
    end tell
  end tell
end run
EOF
}

terminal_focus_existing() {
  local target=$1 win index tty cwd
  while IFS=$'\t' read -r win index tty; do
    cwd=$(tty_cwd "$tty") || continue
    in_target "$cwd" "$target" || continue
    osascript - "$win" "$index" >/dev/null <<'EOF'
on run argv
  tell application "Terminal"
    set w to window id ((item 1 of argv) as integer)
    set selected of tab ((item 2 of argv) as integer) of w to true
    set frontmost of w to true
    activate
  end tell
end run
EOF
    return 0
  done < <(osascript <<'EOF'
set out to ""
set sep to tab
tell application "Terminal"
  repeat with w in windows
    repeat with i from 1 to count of tabs of w
      set out to out & (id of w) & sep & i & sep & (tty of tab i of w) & linefeed
    end repeat
  end repeat
end tell
return out
EOF
  )
  return 1
}

# Terminal has no scripting call for a new tab: the shortcut needs Accessibility, else open a window
terminal_new_tab() {
  osascript - "$1" >/dev/null 2>&1 <<'EOF'
on run argv
  set command to "cd " & quoted form of (item 1 of argv)
  tell application "Terminal" to activate
  try
    tell application "System Events" to keystroke "t" using command down
    delay 0.3
    tell application "Terminal" to do script command in selected tab of front window
  on error
    tell application "Terminal" to do script command
  end try
end run
EOF
}

open_tab() {
  local dir=$1 kind target
  [[ -d $dir ]] || die "the directory does not exist: $dir"
  kind=$(terminal_kind)
  if [[ $kind == unknown ]]; then
    printf 'wtree: this terminal has no tab support, open this directory: %s\n' "$dir" >&2
    return 0
  fi
  target=$(worktree_of "$dir" "$dir")
  target=${target:-$dir}
  if in_target "$PWD" "$target"; then
    printf 'wtree: you are already in %s\n' "$target" >&2
    return 0
  fi
  if "${kind}_focus_existing" "$target" 2>/dev/null; then return 0; fi
  if ! "${kind}_new_tab" "$dir"; then
    printf 'wtree: could not open a tab in %s, open this directory: %s\n' "$kind" "$dir" >&2
  fi
}

new_worktree() {
  local base path name attempt=0
  base="$(dirname "$(main_worktree)")/worktrees"
  while :; do
    name="${ADJECTIVES[RANDOM % ${#ADJECTIVES[@]}]}-${NOUNS[RANDOM % ${#NOUNS[@]}]}"
    attempt=$((attempt + 1))
    if ((attempt > 50)); then name="$name-$RANDOM"; fi
    path="$base/$name"
    if [[ ! -e $path ]] && ! git worktree list --porcelain | grep -Fxq "worktree $path"; then break; fi
  done
  mkdir -p "$base"
  git worktree add --quiet --detach "$path" HEAD
  printf '%s\n' "$path"
  open_tab "$path"
}

pause() {
  printf 'Press a key to continue. '
  read -r -n1 _ </dev/tty || true
}

refuse() {
  printf 'wtree: %s\n' "$*" >&2
  pause
  return 0
}

read_key() {
  KEY=
  read -r -n1 KEY </dev/tty || KEY=
  printf '\n'
}

confirm() {
  printf '%s [y/N] ' "$1"
  read_key
  [[ $KEY == y || $KEY == Y ]]
}

STEP_COUNT=0
SHOW_OUTPUT=
declare -a STEP_LABEL STEP_AFTER STEP_CMD STEP_RESULT

# after: the steps that must succeed first, separated by a space
add_step() {
  local after=$1 label=$2
  shift 2
  STEP_LABEL[STEP_COUNT]=$label
  STEP_AFTER[STEP_COUNT]=$after
  STEP_CMD[STEP_COUNT]=$(printf '%q ' "$@")
  STEP_COUNT=$((STEP_COUNT + 1))
}

draw_progress() {
  local finished=$1 total=$2 text=$3 cols=$4 width=20 filled i bar='' room
  [[ -t 1 ]] || return 0
  if ((cols < 60)); then width=10; fi
  filled=$((finished * width / total))
  for ((i = 0; i < width; i++)); do
    if ((i < filled)); then bar+='█'; else bar+='░'; fi
  done
  room=$((cols - width - 4))
  if ((room < 8)); then room=8; fi
  if ((${#text} > room)); then text="${text:0:room-1}…"; fi
  printf '\r\033[K[%s] %s' "$bar" "$text"
}

# the output of a step goes to a file, so that it does not break the progress line
run_steps() {
  local i dep blocked pid status log cols frame=0 frames='|/-\' failed=0 skipped=0 finished=0
  local total=$STEP_COUNT
  log=$(mktemp)
  cols=$(term_cols)
  for ((i = 0; i < total; i++)); do
    blocked=
    for dep in ${STEP_AFTER[i]}; do
      if [[ ${STEP_RESULT[dep]} != ok ]]; then blocked=1; fi
    done
    if [[ -n $blocked ]]; then
      STEP_RESULT[i]=skipped
      skipped=$((skipped + 1))
      finished=$((finished + 1))
      printf '\r\033[K- %s: skipped, an earlier step failed\n' "${STEP_LABEL[i]}"
      continue
    fi
    (eval "${STEP_CMD[i]}") </dev/null >"$log" 2>&1 &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
      draw_progress "$finished" "$total" "$((i + 1))/$total ${frames:frame%4:1} ${STEP_LABEL[i]}" "$cols"
      frame=$((frame + 1))
      sleep 0.1
    done
    status=0
    wait "$pid" || status=$?
    finished=$((finished + 1))
    if ((status == 0)); then
      STEP_RESULT[i]=ok
      printf '\r\033[K✓ %s\n' "${STEP_LABEL[i]}"
      if [[ -n $SHOW_OUTPUT ]]; then sed 's/^/    /' "$log"; fi
    else
      STEP_RESULT[i]=failed
      failed=$((failed + 1))
      printf '\r\033[K✗ %s\n' "${STEP_LABEL[i]}"
      tail -n 8 "$log" | sed 's/^/    /'
    fi
  done
  rm -f "$log"
  draw_progress "$finished" "$total" "$((finished - failed - skipped)) of $total done" "$cols"
  if [[ -t 1 ]]; then printf '\n'; else printf '%d of %d done\n' "$((finished - failed - skipped))" "$total"; fi
  if ((failed > 0)); then
    printf '%s, %d skipped.\n' "$(plural "$failed" 'step') failed" "$skipped"
    pause
    return 1
  fi
}

remove_worktree() {
  local path=$1 common=$2 force=${3:-}
  if [[ -n $force ]]; then
    git -C "$common" worktree remove --force "$path"
  else
    git -C "$common" worktree remove "$path"
  fi
}

# prints why a plain delete must not take this worktree
worktree_risk() {
  local path=$1 common=$2 head
  if [[ -n $(git -C "$path" status --porcelain 2>/dev/null) ]]; then
    printf 'it has changed files'
    return 0
  fi
  # git worktree remove does not protect commits that only a detached HEAD holds
  if ! git -C "$path" symbolic-ref -q HEAD >/dev/null 2>&1; then
    head=$(git -C "$path" rev-parse HEAD 2>/dev/null) || {
      printf 'git cannot read it'
      return 0
    }
    if [[ -z $(git -C "$common" for-each-ref --contains "$head" --count=1) ]]; then
      printf 'no branch or tag holds its commit %s' "${head:0:9}"
    fi
  fi
}

# args: force, then the paths, then the repo of each path
delete_worktrees() {
  local force=$1
  shift
  local count=$(($# / 2)) i k n=0 skipped=0 path common main current risk pairs project stacks seen=' ' stack_mode=''
  ((count > 0)) || return 0
  local paths=("${@:1:count}") commons=("${@:count+1}")
  local go_path=() go_common=() go_note=() skip_text=() stack_name=() stack_owner=() wt_step=()
  current=$(git rev-parse --show-toplevel 2>/dev/null) || current=
  for ((i = 0; i < count; i++)); do
    path=${paths[i]}
    common=${commons[i]}
    main=$(main_of "$common")
    risk=
    if [[ $path == "$main" ]]; then
      skip_text[${#skip_text[@]}]="$(basename "$path"): it is the main checkout"
      continue
    elif [[ $path == "$current" ]]; then
      skip_text[${#skip_text[@]}]="$(basename "$path"): you are in this worktree, run wtree from a different one"
      continue
    elif [[ -d $path ]]; then
      risk=$(worktree_risk "$path" "$common")
      if [[ -n $risk && -z $force ]]; then
        skip_text[${#skip_text[@]}]="$(basename "$path"): $risk, press ctrl-f to delete it"
        continue
      fi
    else
      risk='its directory is missing'
    fi
    k=${#go_path[@]}
    go_path[k]=$path
    go_common[k]=$common
    go_note[k]=$risk
  done
  n=${#go_path[@]}
  if ((n > 0)); then pairs=$(stack_pairs); fi
  for ((k = 0; k < n; k++)); do
    stacks=$(stacks_in_worktree "${go_path[k]}" "${go_common[k]}" "$pairs")
    for project in $stacks; do
      if [[ $seen == *" $project "* ]]; then continue; fi
      seen="$seen$project "
      i=${#stack_name[@]}
      stack_name[i]=$project
      stack_owner[i]=$k
    done
  done

  if ((${#skip_text[@]} > 0)); then
    printf 'These stay:\n'
    for ((i = 0; i < ${#skip_text[@]}; i++)); do printf '  %s\n' "${skip_text[i]}"; done
  fi
  if ((n == 0)); then
    refuse "nothing to delete"
    return 0
  fi
  if [[ -n $force ]]; then printf 'FORCE delete %s:\n' "$(plural "$n" 'worktree')"; else printf 'Delete %s:\n' "$(plural "$n" 'worktree')"; fi
  for ((k = 0; k < n; k++)); do
    printf '  %s' "$(short_path "${go_path[k]}")"
    if [[ -n ${go_note[k]} ]]; then printf '  (%s)' "${go_note[k]}"; fi
    printf '\n'
  done
  if [[ -n $force ]]; then
    printf 'Changed files, untracked files, ignored files, and commits that no branch or tag holds are lost.\n'
  else
    printf 'Ignored files, such as .env and node_modules, are deleted too.\n'
  fi
  if ((${#stack_name[@]} == 0)); then
    confirm 'Continue?' || return 0
  else
    printf 'Docker stacks of these worktrees:\n'
    for ((i = 0; i < ${#stack_name[@]}; i++)); do
      printf '  %s  (%s)\n' "${stack_name[i]}" "$(basename "${go_path[stack_owner[i]]}")"
    done
    printf '[y: worktrees only, s: and stacks, keep volumes, v: and stacks with volumes, N: no] '
    read_key
    case $KEY in
      y | Y) ;;
      s | S) stack_mode=keep ;;
      v | V) stack_mode=volumes ;;
      *) return 0 ;;
    esac
  fi

  for ((k = 0; k < n; k++)); do
    if [[ -d ${go_path[k]} ]]; then
      add_step '' "delete worktree $(basename "${go_path[k]}")" remove_worktree "${go_path[k]}" "${go_common[k]}" "$force"
    else
      add_step '' "remove missing worktree $(basename "${go_path[k]}")" git -C "${go_common[k]}" worktree prune
    fi
    wt_step[k]=$((STEP_COUNT - 1))
  done
  if [[ -n $stack_mode ]]; then
    for ((i = 0; i < ${#stack_name[@]}; i++)); do
      add_step "${wt_step[stack_owner[i]]}" "delete stack ${stack_name[i]}" stack_down "${stack_name[i]}" "${stack_mode/keep/}"
    done
  fi
  run_steps || true
  if [[ -n $stack_mode ]]; then refresh_disk; fi
}

open_many() {
  local dir dirs=() status=0
  for dir in "$@"; do
    if [[ -n $dir ]]; then dirs[${#dirs[@]}]=$dir; fi
  done
  ((${#dirs[@]} > 0)) || die "the selection has no directory"
  if ((${#dirs[@]} == 1)); then
    open_tab "${dirs[0]}"
    return 0
  fi
  printf 'Open %s:\n' "$(plural "${#dirs[@]}" 'tab')"
  for dir in "${dirs[@]}"; do printf '  %s\n' "$(short_path "$dir")"; done
  confirm 'Continue?' || return 0
  for dir in "${dirs[@]}"; do add_step '' "open $(basename "$dir")" open_tab "$dir"; done
  SHOW_OUTPUT=1
  run_steps || status=1
  return "$status"
}

# PICKED_1 and PICKED_2 get the first two fields of each selected row
split_selection() {
  local rest=$1 row n=0
  PICKED_1=()
  PICKED_2=()
  while [[ $rest == *$'\036'* ]]; do
    row=${rest%%$'\036'*}
    rest=${rest#*$'\036'}
    PICKED_1[n]=${row%%$'\t'*}
    row=${row#*$'\t'}
    PICKED_2[n]=${row%%$'\t'*}
    n=$((n + 1))
  done
}

pick_worktree() {
  require_fzf
  local selected count title action tap='' layout
  export WTREE_SELF=$0
  while :; do
    layout=(--height=80% --header=$'tab: select   ctrl-a: select all   enter: open   ctrl-d: delete   ctrl-f: force delete\nctrl-r: reload   esc: quit')
    if [[ -n $tap ]]; then
      layout=(--height=100% --no-scrollbar --bind='left-click:toggle' --header=$'tap: select   enter: actions   esc: quit')
    elif is_narrow; then
      layout=(--height=100% --no-scrollbar --bind='left-click:accept' --header=$'enter: menu   tab: select   esc: quit\nctrl-d: delete   ctrl-f: force')
    fi
    selected=$(: | SHELL=$(command -v bash) fzf \
      --read0 --print0 --multi --ansi --highlight-line \
      --layout=reverse --info=inline \
      --prompt="$(is_global && printf 'all worktrees' || printf 'worktree') > " \
      --delimiter=$'\t' --with-nth=3 \
      "${layout[@]}" \
      --bind='start:reload("$WTREE_SELF" --list)' \
      --bind='ctrl-a:toggle-all' \
      --bind='ctrl-d:execute("$WTREE_SELF" --delete {+1} {+2})+reload("$WTREE_SELF" --list)' \
      --bind='ctrl-f:execute("$WTREE_SELF" --force-delete {+1} {+2})+reload("$WTREE_SELF" --list)' \
      --bind='ctrl-r:reload("$WTREE_SELF" --rescan)' | tr '\0' '\036') || {
      fzf_exit $?
      continue
    }
    split_selection "$selected"
    count=${#PICKED_1[@]}
    ((count > 0)) || continue
    if [[ -z $tap ]] && ! is_narrow; then
      open_many "${PICKED_1[@]}"
      return 0
    fi
    tap=
    if ((count == 1)); then
      title=$(basename "${PICKED_1[0]}")
      action=$(menu "$title" open delete 'force delete' 'select several' back) || continue
    else
      title=$(plural "$count" 'worktree')
      action=$(menu "$title" open delete 'force delete' back) || continue
    fi
    case $action in
      open)
        open_many "${PICKED_1[@]}"
        return 0
        ;;
      delete) delete_worktrees '' "${PICKED_1[@]}" "${PICKED_2[@]}" ;;
      'force delete') delete_worktrees force "${PICKED_1[@]}" "${PICKED_2[@]}" ;;
      'select several') tap=1 ;;
    esac
  done
}

cache_dir() {
  printf '%s/wtree' "${XDG_CACHE_HOME:-$HOME/.cache}"
}

# docker system df needs a minute or more on a large engine, so it runs detached and fills a cache
refresh_disk() {
  local dir tmp
  dir=$(cache_dir)
  mkdir -p "$dir"
  find "$dir/lock" -maxdepth 0 -mmin +15 -exec rmdir {} + 2>/dev/null || true
  mkdir "$dir/lock" 2>/dev/null || return 0
  tmp="$dir/tmp.$$"
  (
    trap 'rm -f "$tmp"; rmdir "$dir/lock"' EXIT
    docker system df -v --format '{{range .Volumes}}{{.Labels}}\t{{.Size}}\n{{end}}{{range .Containers}}{{.Labels}}\t{{.Size}}\n{{end}}' | awk -F'\t' '
      function bytes(s, n, u) {
        n = s + 0; u = s; sub(/^[0-9.]+/, "", u)
        return n * (u == "kB" ? 1e3 : u == "MB" ? 1e6 : u == "GB" ? 1e9 : u == "TB" ? 1e12 : 1)
      }
      match($1, /com\.docker\.compose\.project=[^,]*/) {
        total[substr($1, RSTART + 27, RLENGTH - 27)] += bytes($2)
      }
      END { for (p in total) printf "%s\t%.0f\n", p, total[p] }' >"$tmp"
    mv "$tmp" "$dir/disk-projects"
    docker system df --format '{{.Type}}\t{{.Size}}' >"$tmp"
    mv "$tmp" "$dir/disk-totals"
  ) </dev/null >/dev/null 2>&1 &
}

disk_is_old() {
  local file
  file="$(cache_dir)/disk-totals"
  [[ ! -f $file ]] || [[ -n $(find "$file" -mmin +30) ]]
}

stack_kind() {
  local project=$1 dir=$2 common=$3 repo=$4 found lower
  if is_global; then
    if [[ -z $dir ]] || found=$(common_of "$dir"); then
      printf 'live'
    elif [[ -d $dir ]]; then
      printf 'plain'
    else
      printf 'gone'
    fi
    return 0
  fi
  [[ -n $dir ]] || return 0
  if found=$(common_of "$dir"); then
    if [[ $found == "$common" ]]; then printf 'live'; fi
    return 0
  fi
  lower=$(printf '%s' "$project" | tr '[:upper:]' '[:lower:]')
  if [[ $lower == "$repo" || $lower == "$repo"-* ]]; then
    printf 'gone'
    return 0
  fi
  lower=$(printf '%s' "/$dir/" | tr '[:upper:]' '[:lower:]')
  case $lower in
    */"$repo"/* | */"$repo"-* | */"$repo".*) printf 'gone' ;;
  esac
}

list_stacks() {
  local common='' repo='' project dir kind ncpu memtotal age=-1 lower disk_projects=/dev/null disk_totals=/dev/null cache
  WTREE_TMP=$(mktemp -d)
  trap 'rm -rf "$WTREE_TMP"' EXIT
  if ! is_global; then
    common=$(common_of "$PWD")
    repo=$(basename "$(main_worktree)" | tr '[:upper:]' '[:lower:]')
  fi
  cache=$(cache_dir)

  docker ps -a --filter label=com.docker.compose.project --format '{{.Label "com.docker.compose.project"}}\t{{.Label "com.docker.compose.project.working_dir"}}\t{{.State}}\t{{.ID}}' >"$WTREE_TMP/ps"
  docker stats --no-stream --format '{{.ID}}\t{{.CPUPerc}}\t{{.MemUsage}}' >"$WTREE_TMP/stats"
  docker volume ls --filter label=com.docker.compose.project --format '{{.Label "com.docker.compose.project"}}' >"$WTREE_TMP/volumes"
  ncpu=$(docker info --format '{{.NCPU}}')
  memtotal=$(docker info --format '{{.MemTotal}}')

  list_repos "$(cut -f2 "$WTREE_TMP/ps")" | worktree_stream | awk '
    function basename_of(p) { sub(/\/$/, "", p); sub(/.*\//, "", p); return p }
    /^repo /     { first = 1; next }
    /^worktree / { path = substr($0, 10); ref = "" }
    /^branch /   { ref = substr($0, 8); sub(/^refs\/heads\//, "", ref) }
    /^detached/  { ref = "(detached)" }
    /^$/ {
      if (first) { name = basename_of(path); sub(/\.git$/, "", name) }
      first = 0
      printf "%s\t%s\t%s\n", path, ref, name
    }' >"$WTREE_TMP/worktrees"
  : >"$WTREE_TMP/members"
  while IFS=$'\037' read -r project dir; do
    kind=$(stack_kind "$project" "$dir" "$common" "$repo")
    if [[ -n $kind ]]; then printf '%s\t%s\t%s\n' "$project" "$kind" "$dir" >>"$WTREE_TMP/members"; fi
  done < <(awk -F'\t' '!seen[$1 FS $2]++ { print $1 "\037" $2 }' "$WTREE_TMP/ps")
  while read -r project; do
    lower=$(printf '%s' "$project" | tr '[:upper:]' '[:lower:]')
    if { is_global || [[ $lower == "$repo" || $lower == "$repo"-* ]]; } && ! cut -f1 "$WTREE_TMP/ps" | grep -Fxq "$project"; then
      printf '%s\tvolumes\t\n' "$project" >>"$WTREE_TMP/members"
    fi
  done < <(sort -u "$WTREE_TMP/volumes")

  if [[ -f $cache/disk-projects ]]; then disk_projects=$cache/disk-projects; fi
  if [[ -f $cache/disk-totals ]]; then
    disk_totals=$cache/disk-totals
    age=$((($(date +%s) - $(date -r "$disk_totals" +%s)) / 60))
  fi

  awk -F'\t' -v global="${WTREE_GLOBAL:-}" -v home="$HOME" -v cols="$(term_cols)" -v ncpu="$ncpu" -v memtotal="$memtotal" -v age="$age" -v busy="$([[ -d $cache/lock ]] && echo 1 || echo 0)" \
    -v worktreesf="$WTREE_TMP/worktrees" -v statsf="$WTREE_TMP/stats" -v membersf="$WTREE_TMP/members" -v psf="$WTREE_TMP/ps" -v volumesf="$WTREE_TMP/volumes" -v diskf="$disk_projects" -v totalsf="$disk_totals" '
    function bytes(s, n, u) {
      n = s + 0; u = s; sub(/^[0-9.]+/, "", u)
      return n * (u == "KiB" ? 1024 : u == "MiB" ? 1048576 : u == "GiB" ? 1073741824 : u == "TiB" ? 1099511627776 : 1)
    }
    function whole(s, u) {
      u = s; sub(/^[0-9.]+/, "", u)
      return sprintf("%.0f%s", s + 0, u)
    }
    function mem_text(b) {
      if (b >= 1073741824) return sprintf("%.1fGiB", b / 1073741824)
      return sprintf("%.0fMiB", b / 1048576)
    }
    function disk_text(b) {
      if (b >= 1e9) return sprintf("%.1fGB", b / 1e9)
      if (b >= 1e6) return sprintf("%.0fMB", b / 1e6)
      return sprintf("%.0fkB", b / 1e3)
    }
    FILENAME == worktreesf { wn++; wp[wn] = $1; wr[wn] = $2; wo[wn] = $3; next }
    FILENAME == statsf { cpu[$1] = $2 + 0; split($3, m, " / "); mem[$1] = bytes(m[1]); allcpu += cpu[$1]; allmem += mem[$1]; next }
    FILENAME == membersf { if (!($1 in kind) || $2 == "live") { kind[$1] = $2; dir[$1] = $3 } next }
    FILENAME == psf { if ($1 in kind) { n[$1, $3]++; pcpu[$1] += cpu[$4]; pmem[$1] += mem[$4] } next }
    FILENAME == volumesf { vols[$1]++; next }
    FILENAME == diskf { disk[$1] = $2; next }
    FILENAME == totalsf { total[$1] = $2; next }
    END {
      narrow = cols < 60
      line = sprintf(narrow ? "CPU %.0f%%/%d%%  mem %s/%s" : "Docker  CPU %.0f%% of %d%%   memory %s of %s", allcpu, ncpu * 100, mem_text(allmem), mem_text(memtotal))
      if (age < 0) d = narrow ? "disk: reading, ctrl-r later" : "disk: Docker is reading the sizes, press ctrl-r later"
      else if (narrow) d = sprintf("img %s ctr %s vol %s bld %s %dm%s", whole(total["Images"]), whole(total["Containers"]), whole(total["Local Volumes"]), whole(total["Build Cache"]), age, busy ? " upd" : "")
      else d = sprintf("disk: images %s, containers %s, volumes %s, build %s (%d min old%s)", total["Images"], total["Containers"], total["Local Volumes"], total["Build Cache"], age, busy ? ", update in progress" : "")
      printf "0\t1\t\t\t\033[2m%s\033[0m\n", line
      printf "0\t2\t\t\t\033[2m%s\033[0m\n", d
      states = "running paused restarting created exited dead removing"
      count = split(states, st, " ")
      for (p in kind) {
        state = ""
        for (i = 1; i <= count; i++) if ((p, st[i]) in n) state = state (state == "" ? "" : ", ") st[i] " " n[p, st[i]]
        if (state == "") state = "no containers"
        note = kind[p] == "gone" ? "  \033[33mworktree gone\033[0m" : kind[p] == "volumes" ? "  \033[33mvolumes only\033[0m" : ""
        branch = ""; owner = ""; bestlen = 0
        for (j = 1; j <= wn; j++) {
          if ((dir[p] == wp[j] || index(dir[p], wp[j] "/") == 1) && length(wp[j]) > bestlen) { branch = wr[j]; owner = wo[j]; bestlen = length(wp[j]) }
        }
        on = branch == "" ? "" : "\033[35mon " (global != "" ? owner " " : "") branch "\033[0m"
        shown = dir[p]
        if (index(shown, home "/") == 1) shown = "~" substr(shown, length(home) + 1)
        usage = (((p, "running") in n) ? sprintf("CPU %.1f%%  memory %s  ", pcpu[p], mem_text(pmem[p])) : "") "disk " ((p in disk) ? disk_text(disk[p]) : "?") "  volumes " (vols[p] + 0)
        rank = ((p, "running") in n) ? 1 : 2
        if (narrow) {
          usage = ((rank == 1) ? sprintf("CPU %.1f%%  mem %s  ", pcpu[p], mem_text(pmem[p])) : "") "disk " ((p in disk) ? disk_text(disk[p]) : "?") "  vol " (vols[p] + 0)
          if (on != "") usage = on "\037  " usage
          if (length(shown) > cols - 6) shown = "…" substr(shown, length(shown) - cols + 8)
          printf "%d\t%s\t%s\t%s\t\033[1m%s\033[0m\037  \033[36m%s\033[0m%s\037  %s\037  \033[2m%s\033[0m\n", rank, p, p, dir[p], p, state, note, usage, shown
        } else {
          if (on != "") note = note "  " on
          printf "%d\t%s\t%s\t%s\t\033[1m%s\033[0m  \033[36m%s\033[0m%s\037  %s  \033[2m%s\033[0m\n", rank, p, p, dir[p], p, state, note, usage, shown
        }
      }
    }' "$WTREE_TMP/worktrees" "$WTREE_TMP/stats" "$WTREE_TMP/members" "$WTREE_TMP/ps" "$WTREE_TMP/volumes" "$disk_projects" "$disk_totals" |
    sort | cut -f3- | tr '\n\037' '\0\n'
}

# compose reads a compose file in the directory, so a stack from another directory needs none there
compose() {
  (
    unset COMPOSE_FILE
    cd / && docker compose "$@"
  )
}

stack_down() {
  local project=$1 with_volumes=${2:-} volume
  compose -p "$project" down
  if [[ -n $with_volumes ]]; then
    for volume in $(docker volume ls -q --filter "label=com.docker.compose.project=$project"); do
      docker volume rm "$volume"
    done
  fi
}

# a stack without a linked worktree can hold the only copy of its data
stack_is_protected() {
  local dir=$1 main
  [[ -n $dir && -d $dir ]] || return 1
  main=$(main_of "$dir")
  [[ -z $main || $dir == "$main" || $dir == "$main"/* ]]
}

stop_stacks() {
  local project
  (($# > 0)) || return 0
  if (($# > 1)); then
    printf 'Stop %s:\n' "$(plural "$#" 'stack')"
    for project in "$@"; do printf '  %s\n' "$project"; done
    confirm 'Continue?' || return 0
  fi
  for project in "$@"; do add_step '' "stop stack $project" compose -p "$project" stop; done
  run_steps || true
}

# args: with_volumes, then the stacks, then the directory of each stack
delete_stacks() {
  local with_volumes=$1
  shift
  local count=$(($# / 2)) i k n=0 project dir current wt common main risk seen=' ' volumes=0 found phrase with_worktrees='' answer after
  ((count > 0)) || return 0
  local all_projects=("${@:1:count}") all_dirs=("${@:count+1}")
  local projects=() dirs=() counts=() protected=() wt_path=() wt_common=() wt_keep=() owner=()
  current=$(git rev-parse --show-toplevel 2>/dev/null) || current=
  for ((i = 0; i < count; i++)); do
    if [[ -z ${all_projects[i]} ]]; then continue; fi
    n=${#projects[@]}
    projects[n]=${all_projects[i]}
    dirs[n]=${all_dirs[i]}
    owner[n]=-1
    counts[n]=0
    dir=${dirs[n]}
    if [[ -n $with_volumes ]]; then
      counts[n]=$(docker volume ls -q --filter "label=com.docker.compose.project=${projects[n]}" | wc -l | tr -d ' ')
      volumes=$((volumes + counts[n]))
      if stack_is_protected "$dir"; then protected[${#protected[@]}]=${projects[n]}; fi
    fi
    [[ -n $dir && -d $dir ]] || continue
    wt=$(worktree_of "$dir" "$dir")
    main=$(main_of "$dir")
    [[ -n $wt && $wt != "$main" && $wt != "$current" ]] || continue
    common=$(common_of "$dir") || continue
    found=-1
    for ((k = 0; k < ${#wt_path[@]}; k++)); do
      if [[ ${wt_path[k]} == "$wt" ]]; then found=$k; fi
    done
    if ((found >= 0)); then
      owner[n]=$found
      continue
    fi
    risk=$(worktree_risk "$wt" "$common")
    if [[ -n $risk ]]; then
      if [[ $seen != *" $wt "* ]]; then
        seen="$seen$wt "
        wt_keep[${#wt_keep[@]}]="$(basename "$wt"): $risk"
      fi
      continue
    fi
    k=${#wt_path[@]}
    wt_path[k]=$wt
    wt_common[k]=$common
    owner[n]=$k
  done
  n=${#projects[@]}
  ((n > 0)) || return 0

  if [[ -n $with_volumes ]]; then
    printf 'Delete %s and %s:\n' "$(plural "$n" 'stack')" "$(plural "$volumes" 'volume')"
    for ((i = 0; i < n; i++)); do printf '  %s  (%s)\n' "${projects[i]}" "$(plural "${counts[i]}" 'volume')"; done
    printf 'The data in the volumes is lost.\n'
  else
    printf 'Delete the containers and networks of %s. The volumes stay:\n' "$(plural "$n" 'stack')"
    for ((i = 0; i < n; i++)); do printf '  %s\n' "${projects[i]}"; done
  fi

  if ((${#protected[@]} > 0)); then
    printf 'These stacks belong to a main checkout, or to no repo:\n'
    for ((i = 0; i < ${#protected[@]}; i++)); do printf '  %s\n' "${protected[i]}"; done
    printf 'All the worktrees stay.\n'
    wt_path=()
  elif ((${#wt_keep[@]} > 0)); then
    printf 'These worktrees stay:\n'
    for ((i = 0; i < ${#wt_keep[@]}; i++)); do printf '  %s\n' "${wt_keep[i]}"; done
  fi
  if ((${#wt_path[@]} > 0)); then
    printf 'Worktrees of these stacks:\n'
    for ((k = 0; k < ${#wt_path[@]}; k++)); do printf '  %s\n' "$(short_path "${wt_path[k]}")"; done
    printf 'Deleting a worktree also deletes its ignored files, such as .env and node_modules.\n'
  fi
  # volume data does not come back, so a stray key must not delete it from several stacks
  if [[ -n $with_volumes ]] && ((n > 1 || ${#protected[@]} > 0)); then
    phrase=${projects[0]}
    if ((n > 1)); then phrase=$(plural "$n" 'stack'); fi
    if ((${#wt_path[@]} > 0)); then
      printf 'Type "%s" to delete, or "%s w" to delete the worktrees too: ' "$phrase" "$phrase"
    else
      printf 'Type "%s" to delete: ' "$phrase"
    fi
    read -r answer </dev/tty || answer=
    if ((${#wt_path[@]} > 0)) && [[ $answer == "$phrase w" ]]; then
      with_worktrees=1
    elif [[ $answer != "$phrase" ]]; then
      return 0
    fi
  elif ((${#wt_path[@]} == 0)); then
    confirm 'Continue?' || return 0
  else
    printf '[y: stacks only, w: and worktrees, N: no] '
    read_key
    case $KEY in
      y | Y) ;;
      w | W) with_worktrees=1 ;;
      *) return 0 ;;
    esac
  fi

  for ((i = 0; i < n; i++)); do
    add_step '' "delete stack ${projects[i]}" stack_down "${projects[i]}" "$with_volumes"
  done
  if [[ -n $with_worktrees ]]; then
    for ((k = 0; k < ${#wt_path[@]}; k++)); do
      after=
      for ((i = 0; i < n; i++)); do
        if ((owner[i] == k)); then after="$after $i"; fi
      done
      add_step "$after" "delete worktree $(basename "${wt_path[k]}")" remove_worktree "${wt_path[k]}" "${wt_common[k]}"
    done
  fi
  run_steps || true
  refresh_disk
}

pick_stack() {
  require_fzf
  command -v docker >/dev/null 2>&1 || die "docker is not on PATH"
  docker info >/dev/null 2>&1 || die "Docker is not running"
  local selected count title action tap='' layout
  export WTREE_SELF=$0
  if disk_is_old; then refresh_disk; fi
  while :; do
    layout=(--height=80% --header=$'tab: select   ctrl-a: select all   enter: open   ctrl-s: stop\nctrl-d: delete   ctrl-f: delete with volumes   ctrl-r: reload   esc: quit')
    if [[ -n $tap ]]; then
      layout=(--height=100% --no-scrollbar --bind='left-click:toggle' --header=$'tap: select   enter: actions   esc: quit')
    elif is_narrow; then
      layout=(--height=100% --no-scrollbar --bind='left-click:accept' --header=$'enter: menu   tab: select\nctrl-r: reload   esc: quit')
    fi
    selected=$(: | SHELL=$(command -v bash) fzf \
      --read0 --print0 --multi --ansi --highlight-line --header-lines=2 \
      --layout=reverse --info=inline \
      --prompt="$(is_global && printf 'all stacks' || printf 'stack') > " \
      --delimiter=$'\t' --with-nth=3 \
      "${layout[@]}" \
      --bind='start:reload("$WTREE_SELF" --stack-list)' \
      --bind='ctrl-a:toggle-all' \
      --bind='ctrl-s:execute("$WTREE_SELF" --stack-stop {+1})+reload("$WTREE_SELF" --stack-list)' \
      --bind='ctrl-d:execute("$WTREE_SELF" --stack-delete {+1} {+2})+reload("$WTREE_SELF" --stack-list)' \
      --bind='ctrl-f:execute("$WTREE_SELF" --stack-purge {+1} {+2})+reload("$WTREE_SELF" --stack-list)' \
      --bind='ctrl-r:reload("$WTREE_SELF" --stack-list)' | tr '\0' '\036') || {
      fzf_exit $?
      continue
    }
    split_selection "$selected"
    count=${#PICKED_1[@]}
    ((count > 0)) || continue
    if [[ -z $tap ]] && ! is_narrow; then
      open_many "${PICKED_2[@]}"
      return 0
    fi
    tap=
    if ((count == 1)); then
      title=${PICKED_1[0]}
      action=$(menu "$title" open stop 'delete, keep volumes' 'delete with volumes' 'select several' back) || continue
    else
      title=$(plural "$count" 'stack')
      action=$(menu "$title" open stop 'delete, keep volumes' 'delete with volumes' back) || continue
    fi
    case $action in
      open)
        open_many "${PICKED_2[@]}"
        return 0
        ;;
      stop) stop_stacks "${PICKED_1[@]}" ;;
      'delete, keep volumes') delete_stacks '' "${PICKED_1[@]}" "${PICKED_2[@]}" ;;
      'delete with volumes') delete_stacks volumes "${PICKED_1[@]}" "${PICKED_2[@]}" ;;
      'select several') tap=1 ;;
    esac
  done
}

# bash reads a script while it runs, so load all of it before the first command
main() {
  local mode=''
  while (($#)); do
    case $1 in
      -g | --global) export WTREE_GLOBAL=1 ;;
      -gd | -dg)
        export WTREE_GLOBAL=1
        mode=-d
        ;;
      -d | --docker | -n | --new | -h | --help)
        [[ -z $mode ]] || die "use one of -n and -d"
        mode=$1
        ;;
      *) break ;;
    esac
    shift
  done
  if [[ -n $mode ]]; then
    (($# == 0)) || die "unknown argument: $1"
  else
    mode=${1:-}
    if (($#)); then shift; fi
  fi
  case $mode in
    -h | --help)
      usage
      exit 0
      ;;
    -n | --new)
      if is_global; then die "-n creates a worktree in this repo, so it does not work with -g"; fi
      ;;
    "" | -d | --docker | --list | --rescan | --stack-list) (($# == 0)) || die "unknown argument: $1" ;;
    --stack-stop) (($# > 0)) || die "$mode needs a stack" ;;
    --stack-delete | --stack-purge) (($# % 2 == 0)) || die "$mode needs a directory for each stack" ;;
    --delete | --force-delete) (($# % 2 == 0)) || die "$mode needs a repo for each path" ;;
    *)
      usage >&2
      die "unknown argument: $mode"
      ;;
  esac

  if ! is_global; then
    git rev-parse --git-dir >/dev/null 2>&1 || die "not a git repository: $PWD"
  fi

  case $mode in
    "") pick_worktree ;;
    -n | --new) new_worktree ;;
    --list) list_worktrees ;;
    --rescan)
      if is_global; then rescan_repos; fi
      list_worktrees
      ;;
    --delete) delete_worktrees '' "$@" ;;
    --force-delete) delete_worktrees force "$@" ;;
    -d | --docker) pick_stack ;;
    --stack-list) list_stacks ;;
    --stack-stop) stop_stacks "$@" ;;
    --stack-delete) delete_stacks '' "$@" ;;
    --stack-purge) delete_stacks volumes "$@" ;;
  esac
}

main "$@"; exit
